# API base URL for the FastAPI backend.
# Local development default. In Vercel, set this to the Render backend URL.
# Never place secrets in VITE_* variables: they are embedded in the browser bundle.
VITE_API_BASE_URL=http://localhost:8000

# Public Supabase Auth client configuration. These are safe for the browser;
# never add a service-role key, SMTP password, or other privileged secret here.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
