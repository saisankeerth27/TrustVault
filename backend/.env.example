# TrustVault backend configuration template.
# Copy this file to backend/.env for local development. Never commit .env.

# Application
APP_NAME=TrustVault API
APP_VERSION=0.1.0
APP_ENV=development
LOG_LEVEL=INFO

# Comma-separated list of exact frontend origins. Wildcards are rejected outside development.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Not used in Phase 1. Added in later phases:
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/database
# JWT_SECRET=replace-with-a-long-random-value
# WASABI_ACCESS_KEY=replace-me
# WASABI_SECRET_KEY=replace-me
# WASABI_BUCKET=replace-me
# WASABI_ENDPOINT=https://s3.wasabisys.com
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=replace-me
