# TrustVault backend configuration template.
# Copy this file to backend/.env for local development. Never commit .env.

# Application
APP_NAME=TrustVault API
APP_VERSION=0.1.0
APP_ENV=development
LOG_LEVEL=INFO

# Comma-separated list of exact frontend origins. Wildcards are rejected outside development.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# PostgreSQL (Supabase). Use the direct connection (port 5432) for Alembic
# migrations. The transaction pooler (port 6543) is supported for the Render app.
# Replace every placeholder locally or in Render. Never commit the real value.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# SQLAlchemy pool sizing. Adjust for the Render instance and Supabase plan.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# The backend and Alembic read DATABASE_URL only. The isolated test suite runs an
# embedded PostgreSQL instance and never reads this variable.

# Authentication. Generate JWT_SECRET with a cryptographically secure random source,
# for example: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Never reuse a placeholder in production and never commit the real value.
JWT_SECRET=replace-me
JWT_ALGORITHM=HS256
JWT_ISSUER=trustvault
JWT_AUDIENCE=trustvault-api
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12

# Refresh cookie and CSRF-related cookie policy. SameSite=None requires Secure and
# is intended for cross-site Vercel -> Render deployments. Use lax locally.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_RATE_LIMIT_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# Private Supabase Storage. Keep the bucket private and never expose the
# service-role or secret key to Vite or the browser. SUPABASE_URL must be the
# HTTPS project URL without a path.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_STORAGE_BUCKET=trustvault-documents
SUPABASE_SERVICE_ROLE_KEY=replace-me
MAX_UPLOAD_SIZE_BYTES=10485760
ALLOWED_UPLOAD_EXTENSIONS=pdf,txt,docx,png,jpg,jpeg

# Signed audit checkpoints. Configure BOTH values or leave BOTH unset. The key
# must be at least 32 characters and the path must be absolute. Use persistent,
# access-controlled storage; a same-host file is not an independent checkpoint
# store. Generate a key with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# AUDIT_CHECKPOINT_SIGNING_KEY=replace-with-at-least-32-random-characters
# AUDIT_CHECKPOINT_PATH=/absolute/persistent/path/audit-checkpoint.json
